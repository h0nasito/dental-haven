# Copy to .env and fill in. Never commit .env.
APP_ENV=development                # set to "production" on the live server
SECRET_KEY=                        # required in production: python -c "import secrets;print(secrets.token_hex(32))"
# DATABASE_URL defaults to SQLite at instance/dental_haven.db
# DATABASE_URL=postgresql://dental_haven:CHANGE_ME@localhost:5432/dental_haven
UPLOAD_DIR=instance/uploads        # private patient documents; keep outside the web root and back it up
MAX_UPLOAD_MB=10
CLINIC_TIMEZONE=Asia/Manila
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
PUBLIC_RATE_LIMIT=8                # public form submissions per IP per hour
# SEED_DEMO_PASSWORD=             # optional fixed password for demo accounts (development only)

# Messaging — NOT CONFIGURED. Only the manual provider exists. See docs/INTEGRATIONS.md.
# SMS_PROVIDER=
# SMS_API_KEY=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# Dentist appointment emails (off until set; the demo never sends). Needs a paid Render plan:
# free Render services block outgoing email. One Gmail per branch, each with a Gmail APP password.
# MAIL_MALOLOS_USERNAME=dentalhavenmalolos@gmail.com
# MAIL_MALOLOS_PASSWORD=
# MAIL_GUIGUINTO_USERNAME=dentalhavenguiguintobranch@gmail.com
# MAIL_GUIGUINTO_PASSWORD=
# MAIL_BOCAUE_USERNAME=dentalhavenbocaue@gmail.com
# MAIL_BOCAUE_PASSWORD=
# MAIL_SJDM_USERNAME=dentalhavensjdm@gmail.com
# MAIL_SJDM_PASSWORD=
# MAIL_USERNAME= / MAIL_PASSWORD=               # optional shared fallback sender
# PUBLIC_BASE_URL=https://your-live-site.example # link in the email; defaults to the site address
