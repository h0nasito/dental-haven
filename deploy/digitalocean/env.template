# Live settings for the Dental Haven system. Only root can read this file.
# After any change:  systemctl restart dental-haven
APP_ENV=production
SECRET_KEY=__SECRET_KEY__
DATA_DIR=__DATA_DIR__
TRUST_PROXY=1
CLINIC_TIMEZONE=Asia/Manila
PUBLIC_BASE_URL=https://__DOMAIN__

# Emails (optional; see docs/DEPLOY_DIGITALOCEAN.md step 7). DigitalOcean blocks the normal email ports, so send
# through Brevo: put your Brevo API key here and remove the # from each branch's USERNAME line (no passwords needed).
#BREVO_API_KEY=
# Branch Gmail accounts (the sender addresses). The PASSWORD lines are only used without Brevo, on hosts that allow email ports.
#MAIL_MALOLOS_USERNAME=dentalhavenmalolos@gmail.com
#MAIL_MALOLOS_PASSWORD=
#MAIL_GUIGUINTO_USERNAME=dentalhavenguiguintobranch@gmail.com
#MAIL_GUIGUINTO_PASSWORD=
#MAIL_BOCAUE_USERNAME=dentalhavenbocaue@gmail.com
#MAIL_BOCAUE_PASSWORD=
#MAIL_SJDM_USERNAME=dentalhavensjdm@gmail.com
#MAIL_SJDM_PASSWORD=

# Patient SMS through Semaphore (optional; leave off until the account is approved).
#SEMAPHORE_API_KEY=
#SEMAPHORE_SENDER_NAME=DentalHaven
